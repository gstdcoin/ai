# GSTD Node — Standalone Docker Image
# Used by: scripts/node-runner.sh, scripts/node-runner.ps1, docker run
# Published to: ghcr.io/gstdcoin/gstd-node:latest

FROM golang:1.24-alpine AS builder

RUN apk add --no-cache gcc musl-dev git

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .

RUN CGO_ENABLED=1 GOOS=linux go build -a \
    -ldflags '-w -s -X main.version=1.0.0' \
    -o gstd-node ./main.go

# ── Runtime ──────────────────────────────────────────────────
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata wget

RUN addgroup -g 1000 gstd && \
    adduser -D -u 1000 -G gstd gstd

WORKDIR /app

COPY --from=builder /app/gstd-node .
COPY --from=builder /app/migrations ./migrations

RUN mkdir -p /app/data && chown -R gstd:gstd /app

USER gstd

EXPOSE 8080

ENV GIN_MODE=release
ENV PORT=8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

LABEL org.opencontainers.image.source="https://github.com/gstdcoin/ai"
LABEL org.opencontainers.image.description="GSTD Global Super Computer Node"
LABEL org.opencontainers.image.licenses="MIT"

CMD ["./gstd-node"]
