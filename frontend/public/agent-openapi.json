{
  "openapi": "3.0.3",
  "info": {
    "title": "GSTD agent access",
    "version": "1.1.0",
    "description": "Public discovery, consented free inference and separately authorized bounded platform-balance spending. No wallet signing or withdrawals."
  },
  "servers": [
    {
      "url": "https://app.gstdtoken.com"
    }
  ],
  "paths": {
    "/api/v1/network/stats": {
      "get": {
        "operationId": "gstd_network_status",
        "summary": "Read live network counters; counters are not payment receipts",
        "responses": {
          "200": {
            "description": "Live registry counters"
          },
          "503": {
            "description": "Status unavailable"
          }
        }
      }
    },
    "/api/v1/models/available": {
      "get": {
        "operationId": "gstd_available_models",
        "summary": "Read live model availability and catalogue prices",
        "responses": {
          "200": {
            "description": "Models, node counts, catalogue prices and observation time"
          }
        }
      }
    },
    "/api/v1/agents/infer": {
      "post": {
        "operationId": "gstd_free_inference",
        "summary": "Send a consented free-only request; consumes shared free quota",
        "description": "No credentials. Explicit network consent and zero GSTD cost ceiling are required. Paid models are rejected, never substituted. Auto explicitly delegates default-model selection to the node. No automatic retries after an uncertain outcome.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "messages",
                  "allow_network",
                  "max_cost_gstd"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "default": "auto",
                    "maxLength": 160
                  },
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "system",
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        }
                      }
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256,
                    "default": 128
                  },
                  "allow_network": {
                    "type": "boolean",
                    "enum": [
                      true
                    ],
                    "description": "Explicit permission to transmit the prompt to a GSTD node"
                  },
                  "max_cost_gstd": {
                    "type": "number",
                    "enum": [
                      0
                    ],
                    "description": "This connector has no spending authority"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OpenAI-compatible completion from an available node"
          },
          "400": {
            "description": "Invalid input, missing consent or credentials supplied"
          },
          "402": {
            "description": "Paid model or exhausted free quota; no payment attempted"
          },
          "429": {
            "description": "Existing IP/free quota limit; do not retry automatically"
          },
          "502": {
            "description": "Node response failed validation"
          },
          "503": {
            "description": "Node or service unavailable"
          }
        }
      }
    },
    "/api/v1/agents/paid-infer": {
      "get": {
        "operationId": "gstd_spending_or_receipt",
        "summary": "Read permission or a request receipt; never retries or spends",
        "security": [
          {
            "AgentGrant": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "request_id",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,100}$"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Permission, or payment state with private response when retained"
          },
          "401": {
            "description": "Invalid grant token"
          },
          "404": {
            "description": "Request not found"
          }
        }
      },
      "post": {
        "operationId": "gstd_paid_inference",
        "summary": "Spend within a separately owner-signed allowance",
        "description": "Record request_id before sending. It binds the exact request; no automatic retries, fallback, model substitution or quota-to-paid upgrade. Revoked/expired grants deny new reservations. Existing reservations may finish. Automatic nonempty exact-model acceptance is part of the signed policy. A model name is not cryptographic proof of quality. Backed ledger credits required.",
        "security": [
          {
            "AgentGrant": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request_id",
                  "model",
                  "prompt",
                  "max_tokens",
                  "allow_network",
                  "max_cost_gstd"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{8,100}$"
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 160,
                    "description": "Exact model authorized by the grant; auto is forbidden."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 512
                  },
                  "allow_network": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "max_cost_gstd": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)([.][0-9]{1,9})?$",
                    "example": "0.005"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Captured exact-model response with 85/10/5 receipt"
          },
          "400": {
            "description": "Invalid request or grant"
          },
          "401": {
            "description": "Invalid grant token"
          },
          "402": {
            "description": "Insufficient balance or cost cap"
          },
          "403": {
            "description": "Revoked or expired"
          },
          "409": {
            "description": "Already processed or conflict; inspect receipt"
          },
          "429": {
            "description": "Rate limited; no automatic retry"
          },
          "503": {
            "description": "Unavailable or execution failed; inspect receipt before retry"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AgentGrant": {
        "type": "http",
        "scheme": "bearer",
        "description": "Private owner-signed, revocable platform-balance inference allowance. Never a wallet session or enterprise key."
      }
    }
  },
  "security": []
}
