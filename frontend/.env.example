# GSTD Platform — Environment Variables
# Vercel KV (Upstash Redis) — auto-added when you connect a KV store in Vercel dashboard
KV_REST_API_URL=https://YOUR-KV.upstash.io
KV_REST_API_TOKEN=YOUR_KV_TOKEN

# Treasury endpoint protection (any random secret string)
TREASURY_SECRET=change-me-to-random-secret

# Bridge vault addresses — cross-chain bridge is deferred (see gstd-bridge CLAUDE.md).
# These MUST be real custodial vault wallets monitored by a running gstd-bridge validator
# set, NOT the GSTD token/mint addresses — leave unset until that service is deployed.
# NOTE: this is the EcosystemTreasury vault (deployed 2026-07-08) — NOT the
# GSTD jetton master address (EQDv6cYW9nNiKjN3Nwl8D6ABjUiH1gYfWVGZhfP7-9tZskTO).
# Never point NEXT_PUBLIC_*_VAULT at a token/mint address.
NEXT_PUBLIC_TON_VAULT=EQAbtTCsty8-gpX-45eotGWxnYG1c7ew7NFsZ9LJBRiv_Ii_
NEXT_PUBLIC_SOL_VAULT=
NEXT_PUBLIC_XRP_VAULT=
GSTD_JETTON_ADDRESS=

# App URLs (auto-set by Vercel, override for self-hosting)
NEXT_PUBLIC_APP_URL=https://app.gstdtoken.com
