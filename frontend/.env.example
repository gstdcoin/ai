# GSTD Platform — Environment Variables
# Vercel KV (Upstash Redis) — auto-added when you connect a KV store in Vercel dashboard
KV_REST_API_URL=https://YOUR-KV.upstash.io
KV_REST_API_TOKEN=YOUR_KV_TOKEN

# Treasury endpoint protection (any random secret string)
TREASURY_SECRET=change-me-to-random-secret

# Contract addresses — set after deploying TON contracts
NEXT_PUBLIC_TON_VAULT=EQDv6cYW9nNiKjN3Nwl8D6ABjUiH1gYfWVGZhfP7-9tZskTO
NEXT_PUBLIC_SOL_VAULT=AzN7uPhQZgThxsRvhNGHPUPRjdEjScTbqQdf5gt6Fqby
NEXT_PUBLIC_XRP_VAULT=ryHSvxUqpcTjoESHbCkMJoqzenjFgPQSf
GSTD_JETTON_ADDRESS=

# App URLs (auto-set by Vercel, override for self-hosting)
NEXT_PUBLIC_APP_URL=https://app.gstdtoken.com
