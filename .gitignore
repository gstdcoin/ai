# ============================================================================
# GSTD Platform - .gitignore
# ============================================================================

# Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example
docker-compose.override.yml
*.pem
*.key
*_secret*
*_private*

# Docker data
postgres_data/
redis_data/
ollama_data/
certbot/
# Nginx configs stay tracked; only TLS / ACME secrets are ignored
nginx/ssl/archive/
nginx/ssl/accounts/
nginx/ssl/live/
nginx/ssl/renewal/
nginx/ssl/*.pem
nginx/ssl/**/*.pem

# Build artifacts
node_modules/
.next/
.next-backup/
dist/
out/
nohup.out
backend/server
backend/backend
backend/backend-app
backend/distributed-computing-platform
backend/backend.log
*.log

# Go compiled binaries (prevent cross-directory contamination)
gstd-backend
gstd-v*
backend/gstd-backend
frontend/gstd-backend
frontend/gstd-v*

# Cross-directory contamination prevention
# Go backend files should NOT be in frontend/
frontend/main.go
frontend/go.mod
frontend/go.sum
frontend/Makefile
frontend/.golangci.yml
frontend/internal/
frontend/cmd/
frontend/migrations/
# Frontend files should NOT be in backend/
backend/next.config.js
backend/next-env.d.ts
backend/next-i18next.config.js
backend/tailwind.config.js
backend/postcss.config.js
backend/tsconfig.json
backend/tsconfig.eslint.json
backend/vercel.json
backend/.eslintrc.json
backend/.lintstagedrc.json
backend/eslint.config.mjs

# System packages
snap/

# Contract build artifacts
contracts/build/
contracts/node_modules/
contracts/deployment-*.json
gstd-contracts/build/
gstd-contracts/temp/

# Dependencies & cache
go/
venv/
__pycache__/
*.pyc
.cache/

# IDE
.vscode/
.idea/
.DS_Store

# OS
Thumbs.db
*.swp
*.swo
*~

# Backups & temp files
backups/
*.sql.gz
*.rdb
*.backup*
*.bak
*.orig
*.tmp

# Obsidian vault (auto-generated operator decisions, not source code)
vault/

# TypeScript build cache
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Nested repos (managed separately)
A2A/
agency-agents/
ai-prompts/
chat-ui/
mcp-server/

# Stub / legacy stubs (remove from tracking)
desktop-client/
gstd-bridge/
agents/

# Transient runtime state (generated by node, never commit)
gstd-node-daemon.js

# IDE workspace (local dev only)
.cursor/
.cursor-server/
.windsurf-server/
.antigravity-server/
.codeium/
.gemini/
.vibe-kanban/

# Wallet data (NEVER commit private keys)
.gstd/

# TonConnect / TON keys
ton-connect-manifest.json
*.tonconnect

# Utility / scratch files (not part of platform)
*.py
!scripts/**/*.py
load-balancer.conf.updated
app.gstdtoken.com.conf
test-project/

# Inspection & log dumps (generated locally, never commit)
*_inspect.json
*_logs.txt
*_recent_logs.txt
*_recent_filtered.txt
mcp_config.json

# Vercel
frontend/.vercel/

# System / User config (never commit)
.bash_history
.bashrc
.profile
.git-credentials
.gitconfig
.ssh/
.npm/
.nvm/
.cargo/
.rustup/
.docker/
.config/
.local/
.venv/
.gnupg/
.history
.selected_editor
.sudo_as_admin_successful
.wget-hsts
.claude/
gstdbot/
.sonarlint/
gstd-universal
backend/main_backend
agents/workflows/
.vercel
