# ============================================================================
# GSTD Platform - .gitignore
# ============================================================================

# Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*_secret*
*_private*

# Docker data
postgres_data/
redis_data/
ollama_data/
certbot/
nginx/

# Build artifacts
node_modules/
.next/
dist/
out/
backend/server
backend/backend
backend/backend-app
backend/distributed-computing-platform
backend/backend.log
*.log

# System packages
snap/

# Contract build artifacts
contracts/build/
contracts/node_modules/
contracts/deployment-*.json
gstd-contracts/build/
gstd-contracts/temp/

# Dependencies & cache
go/
venv/
__pycache__/
*.pyc
.cache/

# IDE
.vscode/
.idea/
.DS_Store

# OS
Thumbs.db
*.swp
*.swo
*~

# Backups & temp files
backups/
*.sql.gz
*.rdb
*.backup*
*.bak

# Nested repos (managed separately)
A2A/

# IDE workspace (local dev only)
.cursor/
.cursor-server/
.windsurf-server/
.antigravity-server/
.codeium/
.gemini/
.vibe-kanban/

# Wallet data (NEVER commit private keys)
.gstd/

# TonConnect / TON keys
ton-connect-manifest.json
*.tonconnect

# Utility / scratch files (not part of platform)
*.py
!scripts/**/*.py
load-balancer.conf.updated
app.gstdtoken.com.conf
test-project/

# Inspection & log dumps (generated locally, never commit)
*_inspect.json
*_logs.txt
*_recent_logs.txt
*_recent_filtered.txt
mcp_config.json

# Symlinks
docker-compose.yml

# Vercel
frontend/.vercel/

# System / User config (never commit)
.bash_history
.bashrc
.profile
.git-credentials
.gitconfig
.ssh/
.npm/
.nvm/
.cargo/
.rustup/
.docker/
.config/
.local/
.venv/
.gnupg/
.history
.selected_editor
.sudo_as_admin_successful
.wget-hsts
.claude/
gstdbot/
.sonarlint/
