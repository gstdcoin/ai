# =============================================================================
# GSTD — пример crontab для прод-хоста (Ubuntu, repo: /home/ubuntu)
# Установка: crontab -e и вставить нужные строки (без комментариев # в начале строки cron).
# Логи: убедитесь что /var/log доступен для записи (или смените пути).
# =============================================================================

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# --- Ежедневный бэкап PostgreSQL (gzip в /home/ubuntu/backups/postgres/, retention 7 дней)
15 3 * * * cd /home/ubuntu && ./scripts/backup_postgres.sh >> /var/log/gstd-pg-backup.log 2>&1

# --- Полный аудит экосистемы каждые 6 часов (только лог)
# 0 */6 * * * cd /home/ubuntu && ./scripts/ecosystem-audit.sh >> /var/log/gstd-ecosystem-audit.log 2>&1

# --- То же + Telegram при FAIL (нужны TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID в /home/ubuntu/.env)
0 */6 * * * cd /home/ubuntu && ./scripts/ecosystem-audit-alert.sh >> /var/log/gstd-ecosystem-audit.log 2>&1

# Off-site (опционально): скопируйте scripts/backup-offsite-rsync.example.sh → backup-offsite-rsync.sh,
# задайте BACKUP_OFFSITE_* и добавьте строку после ежедневного pg backup, например:
# 30 3 * * * BACKUP_OFFSITE_HOST=user@host BACKUP_OFFSITE_PATH=/backups/gstd/ cd /home/ubuntu && ./scripts/backup-offsite-rsync.sh >> /var/log/gstd-backup-offsite.log 2>&1
