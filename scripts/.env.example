# GSTD Scripts — Environment Variables
# Copy to .env and fill in values before running settle.ts or deposit-monitor.ts

# ── Treasury wallet (TON address that receives GSTD deposits from users) ──
# Users send GSTD to this address to top up their platform balance.
# deposit-monitor.ts watches this address for incoming Jetton transfers.
TREASURY_WALLET_ADDRESS=EQ...your_treasury_wallet_here

# ── Jetton contract address (DO NOT CHANGE unless token migrates) ──
GSTD_JETTON_ADDRESS=EQDv6cYW9nNiKjN3Nwl8D6ABjUiH1gYfWVGZhfP7-9tZskTO

# ── Vercel webhook secret (must match TREASURY_SECRET in Vercel env vars) ──
TREASURY_SECRET=your_treasury_secret_here

# ── Platform URL ──
GSTD_SWARM_URL=https://app.gstdtoken.com

# ── TonCenter API key (optional, raises rate limit from 1 req/s to 10 req/s) ──
# Get free key at: https://toncenter.com/api/v2/
# TONCENTER_API_KEY=

# ── Settlement wallet mnemonic (24 words, NEVER put in Vercel!) ──
# Only needed for settle.ts (weekly reward payouts)
# SETTLEMENT_WALLET_MNEMONIC=word1 word2 ... word24
