# =============================================================================
# GSTD Platform — Environment Variables
# Deployment: Vercel (serverless). No Go backend. No Docker in production.
# Set these in Vercel dashboard → Project → Settings → Environment Variables.
# Never commit a real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Vercel KV (Upstash Redis)
# Add these automatically: Vercel dashboard → Storage → Create KV store → Link to project
# -----------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash also provides these aliases (same store, either pair works):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# REQUIRED — Security
# -----------------------------------------------------------------------------
# Protects POST /api/v1/treasury/status (set any secure random string)
TREASURY_SECRET=

# -----------------------------------------------------------------------------
# TON Blockchain (set after contract deploy)
# -----------------------------------------------------------------------------
# Main GSTD Jetton contract address (set after TON mainnet deploy)
GSTD_JETTON_ADDRESS=

# DAO + settlement contracts (set after deploy)
DAO_VOTING=
SETTLEMENT_ROUTER=
STONFI_GSTD_POOL=
TREASURY_GOLD=

# -----------------------------------------------------------------------------
# Frontend — TON (NEXT_PUBLIC_* exposed to browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GSTD_CONTRACT=
NEXT_PUBLIC_AGENT_REGISTRY=
NEXT_PUBLIC_ESCROW_CONTRACT=
NEXT_PUBLIC_DAO_VOTING=
NEXT_PUBLIC_ADMIN_WALLET=

# Vault addresses for cross-chain bridge UI (set after bridge deploy)
NEXT_PUBLIC_TON_VAULT=
NEXT_PUBLIC_SOL_VAULT=
NEXT_PUBLIC_XRP_VAULT=

# TonConnect manifest URL (required for TON wallet connect)
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://app.gstdtoken.com/tonconnect-manifest.json

# TON API (defaults work without a key; add key for higher rate limits)
NEXT_PUBLIC_TONAPI_URL=https://tonapi.io

# RPC gateway (optional — leave empty to use default)
NEXT_PUBLIC_RPC_GATEWAY_URL=

# App public URL
NEXT_PUBLIC_APP_URL=https://app.gstdtoken.com

# WebSocket URL (optional — for real-time features)
NEXT_PUBLIC_WS_URL=

# Xaman (XRPL) API key (optional)
NEXT_PUBLIC_XAMAN_API_KEY=

# -----------------------------------------------------------------------------
# AI Inference (optional — enables Groq fallback when no nodes are online)
# Get key at: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Multichain (optional)
# -----------------------------------------------------------------------------
SOLANA_RPC_URL=
XRPL_WEBSOCKET_URL=

# -----------------------------------------------------------------------------
# Other (optional)
# -----------------------------------------------------------------------------
WALLET_LINK_SECRET=
GSTD_NODE_URL=
