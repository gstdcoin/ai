# Database Configuration
# For local dev: use docker-compose (DB_HOST=gstd_postgres) or set DB_HOST=localhost if Postgres runs locally
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=distributed_computing
DB_SSLMODE=disable

# For verify_liquidity_flow.go (optional):
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable

# PostgreSQL Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=distributed_computing
POSTGRES_HOST_AUTH_METHOD=trust

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# Backend Configuration
SERVER_PORT=8080
SKIP_AUTH_VALIDATION=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://app.gstdtoken.com

# Security Notes:
# 1. Copy this file to .env and set secure passwords
# 2. Never commit .env to version control
# 3. Use strong, unique passwords in production
# 4. Consider using secrets management (e.g., Docker secrets, Kubernetes secrets)

# BOINC Integration Security
BOINC_MASTER_KEY=your-32-character-secure-master-key

# TON / Jetton (no quotes or extra spaces - backend auto-trims)
# GSTD_JETTON_ADDRESS=
# XAUT_JETTON_MASTER=EQA1R_LuQCLHlMgOo1S4G7Y7W1cd0FrAkbA10Zq7rddKxi9k

# Autonomy / Telegram Bot (autonomy/docker-compose.autonomy.yml)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_admin_chat_id
# OLLAMA_API_KEY=your_ollama_api_key_if_required
