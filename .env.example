# =============================================================================
# GSTD Platform — Environment Configuration
# Copy to .env and set values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Backend will not start without these
# -----------------------------------------------------------------------------
BRIDGE_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_NAME=distributed_computing
DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# Redis (required for sessions, rate limit, Compare Mode queue)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TTL_HOURS=24
# Node OS / server jobs: X-Wallet-Link-Secret for POST /api/v1/wallet/link-telegram and /wallet/link-external without browser session
WALLET_LINK_SECRET=

# -----------------------------------------------------------------------------
# TON Blockchain
# -----------------------------------------------------------------------------
TON_NETWORK=mainnet
TON_API_URL=https://tonapi.io
TON_API_KEY=
TON_CONTRACT_ADDRESS=EQAIYlrr3UiMJ9fqI-B4j2nJdiiD7WzyaNL1MX_wiONc4OUi
GSTD_JETTON_ADDRESS=
XAUT_JETTON_MASTER=EQA1R_LuQCLHlMgOo1S4G7Y7W1cd0FrAkbA10Zq7rddKxi9k
STONFI_ROUTER=
ADMIN_WALLET=
COMMISSION_WALLET=
TREASURY_WALLET=
POOL_ADDRESS=EQA--JXG8VSyBJmLMqb2J2t4Pya0TS9SXHh7vHh8Iez25sLp
GOLD_POOL_ADDRESS=
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_PRIVATE_KEY=
PLATFORM_WALLET_SEED=
# Highload Ascension: batch payouts (50+ workers per tx)
LITESERVER_CONFIG_URL=https://ton-blockchain.github.io/global.config.json
HIGHLOAD_WALLET_SEED=
# Bridge oracle — required for POST /api/v1/bridge/swarm-mint (no default in code)
BRIDGE_ORACLE_KEY=
# TON API: key rotation when throughput < 100/s (Advanced plan)
TON_API_KEYS=
PLATFORM_FEE_PERCENT=5
WITHDRAWAL_LOCK_THRESHOLD=500

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
GIN_MODE=release
ADMIN_API_KEY=
ADMIN_API_KEY_2=

# -----------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_* are exposed to browser)
# Canonical prod: API + WebSocket on api.gstdtoken.com (nginx → backend); app UI on app.gstdtoken.com.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.gstdtoken.com
NEXT_PUBLIC_WS_URL=wss://api.gstdtoken.com/ws
NEXT_PUBLIC_GSTD_CONTRACT=
NEXT_PUBLIC_ADMIN_WALLET=
NEXT_PUBLIC_ESCROW_CONTRACT=
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=

# -----------------------------------------------------------------------------
# App URLs (for links, webhooks, Telegram)
# -----------------------------------------------------------------------------
APP_PUBLIC_URL=https://app.gstdtoken.com
# Public API host (Go backend); keep aligned with NEXT_PUBLIC_API_URL origin.
API_PUBLIC_URL=https://api.gstdtoken.com

# -----------------------------------------------------------------------------
# AI / Inference
# -----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_ULTRA_URL=

# Phantom Nodes — free-tier inference providers (single key each)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Telegram (optional — disabled if not set)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
BOT_API_KEY=
# If set, webhook requests must send this in X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token) or ?secret_token=
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Optional Features
# -----------------------------------------------------------------------------
LEVIATHAN_ENABLED=false
SKIP_AUTH_VALIDATION=false
DISABLE_MAINTENANCE_ALERTS=false

# -----------------------------------------------------------------------------
# Economics
# -----------------------------------------------------------------------------
TARGET_PRICE_PER_RESULT_USD=0.03
NET_REVENUE_TO_GOLD_PCT=70

# -----------------------------------------------------------------------------
# Multichain (optional)
# -----------------------------------------------------------------------------
SOLANA_RPC_URL=
XRPL_WEBSOCKET_URL=

# -----------------------------------------------------------------------------
# Docker Compose (repo root — postgres + redis containers)
# Must match DB_PASSWORD / REDIS_PASSWORD used by backend when running in stack
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Root utility scripts (addr-check.go, init-hl.js, fund-hl.js — never commit seeds)
# -----------------------------------------------------------------------------
TON_MNEMONIC=
# Toncenter JSON-RPC only; prefer TON_API_KEY from https://toncenter.com
TON_API_KEY=

# -----------------------------------------------------------------------------
# Other
# -----------------------------------------------------------------------------
BOINC_MASTER_KEY=
EXTERNAL_BANDWIDTH_MBPS=

# -----------------------------------------------------------------------------
# Phase 0 Genesis — Swarm Core
# -----------------------------------------------------------------------------
GSTD_NODE_ID=
GENESIS_MANIFEST_PATH=/app/genesis-manifest.json

# -----------------------------------------------------------------------------
# Vercel Frontend (set in Vercel dashboard, not here)
# -----------------------------------------------------------------------------
# GSTD_API_URL=https://api.gstdtoken.com
# GSTD_WS_URL=wss://api.gstdtoken.com/ws

